generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  password          String?
  image             String?
  createdAt         DateTime            @default(now())
  Activity          Activity[]
  SoccerLeagues     SoccerLeague[]
  TeamsSoccerLeague TeamsSoccerLeague[]
  Players           Players[]
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  type       String
  targetName String
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model SoccerLeague {
  id         String              @id @default(cuid())
  User       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  logo       String?
  public     Boolean             @default(false)
  secondLegs Boolean             @default(false)
  createdAt  DateTime            @default(now())
  Teams      TeamsSoccerLeague[]
  Matches    Match[]
  goals      Goal[]
}

model TeamsSoccerLeague {
  id             Int           @id @default(autoincrement())
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  SoccerLeague   SoccerLeague? @relation(fields: [soccerLeagueId], references: [id], onDelete: Cascade)
  soccerLeagueId String?
  name           String
  sigla          String        @db.VarChar(3)
  logo           String?
  createdAt      DateTime      @default(now())
  points         Int           @default(0)
  playedMatches  Int           @default(0)
  wins           Int           @default(0)
  draws          Int           @default(0)
  losses         Int           @default(0)
  goalsScored    Int           @default(0)
  goalsConceded  Int           @default(0)
  goalsDiff      Int           @default(0)
  Players        Players[]
  Goals          Goal[]
  HomeMatches    Match[]       @relation("HomeMatches")
  AwayMatches    Match[]       @relation("AwayMatches")
}

model Players {
  id                Int                @id @default(autoincrement())
  User              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  TeamsSoccerLeague TeamsSoccerLeague? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            Int?
  name              String
  position          String?
  picture           String?
  createdAt         DateTime           @default(now())
  GoalsScored       Goal[]
}

model Match {
  id             Int               @id @default(autoincrement())
  SoccerLeague   SoccerLeague      @relation(fields: [soccerLeagueId], references: [id], onDelete: Cascade)
  soccerLeagueId String
  HomeTeam       TeamsSoccerLeague @relation("HomeMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  homeTeamId     Int
  AwayTeam       TeamsSoccerLeague @relation("AwayMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  awayTeamId     Int
  homeScore      Int               @default(0)
  awayScore      Int               @default(0)
  round          Int               @default(1)
  isReturnMatch  Boolean           @default(false)
  date           DateTime?
  time           String?
  status         String            @default("SCHEDULED") // Pode ser "SCHEDULED" ou "FINISHED"
  createdAt      DateTime          @default(now())
  Goals          Goal[]
}

model Goal {
  id                Int               @id @default(autoincrement())
  Match             Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId           Int
  Player            Players           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId          Int
  TeamsSoccerLeague TeamsSoccerLeague @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            Int
  SoccerLeague      SoccerLeague      @relation(fields: [soccerLeagueId], references: [id], onDelete: Cascade)
  soccerLeagueId    String
}
