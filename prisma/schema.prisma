generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  name              String
  password          String?
  image             String?
  createdAt         DateTime            @default(now())
  SoccerLeagues     SoccerLeague[]
  TeamsSoccerLeague TeamsSoccerLeague[]
  Players           Players[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model SoccerLeague {
  id         Int                 @id @default(autoincrement())
  User       User?               @relation(fields: [userId], references: [id])
  userId     Int?
  name       String
  logo       String?
  secondLegs Boolean
  stage      Int
  createdAt  DateTime            @default(now())
  Teams      TeamsSoccerLeague[]
}

model TeamsSoccerLeague {
  id             Int           @id @default(autoincrement())
  User           User?         @relation(fields: [userId], references: [id])
  userId         Int?
  SoccerLeague   SoccerLeague? @relation(fields: [soccerLeagueId], references: [id])
  soccerLeagueId Int?
  name           String
  sigla          String        @db.VarChar(3)
  logo           String?
  points         Int           @default(0)
  playedMatches  Int           @default(0)
  wins           Int           @default(0)
  draws          Int           @default(0)
  losses         Int           @default(0)
  goalsScored    Int           @default(0)
  goalsConceded  Int           @default(0)
  goalsDiff      Int           @default(0)
  createdAt      DateTime      @default(now())
  Players        Players[]
}

model Players {
  id                Int                @id @default(autoincrement())
  User              User?              @relation(fields: [userId], references: [id])
  userId            Int?
  TeamsSoccerLeague TeamsSoccerLeague? @relation(fields: [teamId], references: [id])
  teamId            Int?
  name              String
  age               Int?
  position          String?
  picture           String?
  goals             Int                @default(0)
  assists           Int                @default(0)
  cleanSheets       Int                @default(0)
  createdAt         DateTime           @default(now())
}
